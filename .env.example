# Скопируйте в ~/.config/gigachat.env и chmod 600
# Ключ: https://developers.sber.ru/docs/ru/gigachat/quickstart/ind-using-api

GIGACHAT_CREDENTIALS=Basic REPLACE_WITH_AUTHORIZATION_KEY
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_MODEL=GigaChat-3-Ultra
GIGACHAT_VERIFY_SSL_CERTS=false

# Опционально — термины, которые нельзя переводить (через запятую)
# GIGACHAT_PRESERVE_TERMS=Hub,FOG,LoRa,MQTT,OTA
